# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=solo-en-servidor-nunca-en-cliente

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagos (se configuran al conectar un proveedor real)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=cambiar-en-produccion

# Notificaciones push (genera las claves VAPID con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secreto para proteger las rutas de cron (/api/cron/*)
CRON_SECRET=
