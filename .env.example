# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=solo-en-servidor-nunca-en-cliente

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagos / donaciones
# En desarrollo puede usarse mock. En producción, dejar disabled hasta tener PayPal Business verificado.
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=cambiar-solo-si-usas-mock

# PayPal Business institucional (solo servidor; nunca subir valores reales a GitHub)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Soy Templo+ / Google Play Billing
# Se completará al crear la app Android y los productos de suscripción en Play Console.
# Los valores reales y el JSON de servicio deben vivir solo en variables seguras de Vercel/servidor.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_PLUS_MONTHLY_PRODUCT_ID=soy_templo_plus_monthly
GOOGLE_PLAY_PLUS_ANNUAL_PRODUCT_ID=soy_templo_plus_annual
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Notificaciones push (genera las claves VAPID con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secreto para proteger las rutas de cron (/api/cron/*)
CRON_SECRET=
